{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 4,
    "sortPackageJson": false,
    "sortImports": {
        "customGroups": [
            {
                "groupName": "globals-css",
                "selector": "side_effect_style"
            },
            {
                "groupName": "navikt",
                "elementNamePattern": ["@navikt/**"]
            },
            {
                "groupName": "scoped-and-aliases",
                "elementNamePattern": ["@*", "@*/**"]
            }
        ],
        "groups": [
            "globals-css",
            ["builtin", "external"],
            "navikt",
            "scoped-and-aliases",
            ["parent", "sibling", "index"],
            "style",
            "unknown"
        ],
        "ignoreCase": false
    },
    "sortTailwindcss": {
        "stylesheet": "./styles/globals.css"
    },
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "bracketSpacing": false,
                "tabWidth": 2
            }
        }
    ],
    "ignorePatterns": ["dist/**", ".sanity/**", "pnpm-lock.yaml"]
}
