{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "react", "jsx-a11y"],
    "categories": {
        "correctness": "off"
    },
    "ignorePatterns": ["dist/**", ".sanity/**"],
    "rules": {
        "eslint/constructor-super": "error",
        "eslint/for-direction": "error",
        "eslint/getter-return": "error",
        "eslint/no-case-declarations": "warn",
        "eslint/no-class-assign": "warn",
        "eslint/no-compare-neg-zero": "warn",
        "eslint/no-cond-assign": ["warn", "except-parens"],
        "eslint/no-const-assign": "error",
        "eslint/no-constant-condition": ["warn", { "checkLoops": false }],
        "eslint/no-debugger": "warn",
        "eslint/no-delete-var": "error",
        "eslint/no-dupe-class-members": "error",
        "eslint/no-dupe-else-if": "error",
        "eslint/no-dupe-keys": "error",
        "eslint/no-duplicate-case": "error",
        "eslint/no-empty-character-class": "warn",
        "eslint/no-empty-function": "warn",
        "eslint/no-empty-pattern": "warn",
        "eslint/no-ex-assign": "warn",
        "eslint/no-func-assign": "warn",
        "eslint/no-global-assign": "error",
        "eslint/no-import-assign": "error",
        "eslint/no-invalid-regexp": "error",
        "eslint/no-loss-of-precision": "warn",
        "eslint/no-misleading-character-class": "warn",
        "eslint/no-new-native-nonconstructor": "error",
        "eslint/no-nonoctal-decimal-escape": "warn",
        "eslint/no-obj-calls": "error",
        "eslint/no-redeclare": "warn",
        "eslint/no-restricted-globals": [
            "warn",
            "addEventListener",
            "blur",
            "close",
            "closed",
            "confirm",
            "defaultStatus",
            "defaultstatus",
            "event",
            "external",
            "find",
            "focus",
            "frameElement",
            "frames",
            "history",
            "innerHeight",
            "innerWidth",
            "length",
            "location",
            "locationbar",
            "menubar",
            "moveBy",
            "moveTo",
            "name",
            "onblur",
            "onerror",
            "onfocus",
            "onload",
            "onresize",
            "onunload",
            "open",
            "opener",
            "opera",
            "outerHeight",
            "outerWidth",
            "pageXOffset",
            "pageYOffset",
            "parent",
            "print",
            "removeEventListener",
            "resizeBy",
            "resizeTo",
            "screen",
            "screenLeft",
            "screenTop",
            "screenX",
            "screenY",
            "scroll",
            "scrollbars",
            "scrollBy",
            "scrollTo",
            "scrollX",
            "scrollY",
            "self",
            "status",
            "statusbar",
            "stop",
            "toolbar",
            "top"
        ],
        "eslint/no-self-assign": "warn",
        "eslint/no-setter-return": "warn",
        "eslint/no-shadow-restricted-names": "error",
        "eslint/no-sparse-arrays": "warn",
        "eslint/no-this-before-super": "error",
        "eslint/no-unassigned-vars": "warn",
        "eslint/no-unexpected-multiline": "warn",
        "eslint/no-unreachable": "warn",
        "eslint/no-unsafe-finally": "warn",
        "eslint/no-unsafe-negation": "warn",
        "eslint/no-unused-expressions": [
            "warn",
            { "allowShortCircuit": true, "allowTernary": true, "allowTaggedTemplates": true }
        ],
        "eslint/no-unused-labels": "warn",
        "eslint/no-unused-vars": ["warn", { "args": "none", "ignoreRestSiblings": true }],
        "eslint/no-use-before-define": ["warn", { "functions": false, "classes": false, "variables": false }],
        "eslint/no-useless-assignment": "warn",
        "eslint/no-useless-backreference": "warn",
        "eslint/no-useless-escape": "warn",
        "eslint/no-with": "error",
        "eslint/preserve-caught-error": "warn",
        "eslint/require-yield": "warn",
        "eslint/use-isnan": "warn",
        "eslint/valid-typeof": ["warn", { "requireStringLiterals": false }],
        "typescript/no-empty-object-type": "warn",
        "typescript/no-extra-non-null-assertion": "warn",
        "typescript/no-misused-new": "warn",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/no-danger-with-children": "warn",
        "react/void-dom-elements-no-children": "error",
        "react/no-namespace": "error",
        "react/use-memo": "error",
        "react/no-unstable-nested-components": "error",
        "react/no-find-dom-node": "error",
        "react/no-render-return-value": "error",
        "react/no-direct-mutation-state": "error",
        "react/style-prop-object": "warn",
        "react/no-unknown-property": "warn",
        "react/jsx-no-target-blank": "warn",
        "react/no-array-index-key": "warn",
        "react/jsx-key": "warn",
        "react/jsx-no-comment-textnodes": "warn",
        "jsx-a11y/alt-text": "warn",
        "jsx-a11y/anchor-has-content": "warn",
        "jsx-a11y/aria-activedescendant-has-tabindex": "warn",
        "jsx-a11y/aria-props": "warn",
        "jsx-a11y/aria-proptypes": "warn",
        "jsx-a11y/aria-role": ["warn", { "ignoreNonDOM": true }],
        "jsx-a11y/aria-unsupported-elements": "warn",
        "jsx-a11y/heading-has-content": "warn",
        "jsx-a11y/iframe-has-title": "warn",
        "jsx-a11y/img-redundant-alt": "warn",
        "jsx-a11y/no-access-key": "warn",
        "jsx-a11y/no-distracting-elements": "warn",
        "jsx-a11y/no-redundant-roles": "warn",
        "jsx-a11y/role-has-required-aria-props": "warn",
        "jsx-a11y/role-supports-aria-props": "warn",
        "jsx-a11y/scope": "warn"
    }
}
